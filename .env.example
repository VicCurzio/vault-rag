# Copiar a .env y completar. El .env no se commitea.

# Base levantada por docker compose (puerto 55432, ver docker-compose.yml).
DATABASE_URL=postgres://vaultrag:vaultrag@localhost:55432/vaultrag

# Carpeta raiz de las notas en markdown que se van a indexar.
VAULT_PATH=/ruta/a/tus/notas

# Solo hace falta para `npm run ask` (la respuesta generada).
# La busqueda y los evals corren sin esta clave.
ANTHROPIC_API_KEY=

# Carpetas que NO se indexan, separadas por coma (rutas relativas a VAULT_PATH).
# Lo que no esta indexado no puede llegar al modelo cuando se usa `npm run ask`.
# Ejemplo: EXCLUDE_PATHS=Clientes,Personal/Salud
EXCLUDE_PATHS=

# Carpetas que son historia y no estado: siguen buscandose, pero con menos peso.
# Ejemplo: DEMOTE_PATHS=Worklog
DEMOTE_PATHS=
# Cuanto se les baja el puntaje (1 las deja iguales). Sacalo de medir con el eval.
DEMOTE_FACTOR=0.7
